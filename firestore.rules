rules_version = '2';

// Reglas de Firestore para el proyecto compartido de monitoreo/facturación
// (ver dashboard/, panel-remoto/, src/main/heartbeat.ts, src/main/facturacionSync.ts).
//
// IMPORTANTE: este archivo no se aplicaba solo hasta ahora — no existía
// ningún firestore.rules en el repo, así que las reglas vigentes hoy en el
// proyecto de Firebase viven únicamente en la consola. Antes de desplegar
// esto, revisa que la sección "estacionamientos/{slug}" reproduzca el
// comportamiento actual (dashboard.html y panel-remoto.html deben seguir
// pudiendo leer/escribir con auth anónima) — no lo hagas a ciegas.
service cloud.firestore {
  match /databases/{database}/documents {

    // UID del super admin (tú) — debe coincidir con SUPER_ADMIN_UID en
    // functions/src/superAdmin.ts y con el valor hardcodeado en
    // panel-operador/index.html. Se obtiene creando tu propio usuario a
    // mano en Firebase Console → Authentication → Add user.
    function esSuperAdmin() {
      return request.auth != null && request.auth.uid == 'CWNhpqZAmZhfXrKxjtmrYWrTpbf2';
    }

    match /estacionamientos/{slug} {
      // get/create/update de un doc conocido por su slug: cualquier sesión
      // autenticada, incluida la anónima — es el camino que usa la app de
      // escritorio (heartbeat.ts) para su latido/config. Sin cambios de
      // superficie respecto a como funcionaba antes de "socios".
      allow get, create, update: if request.auth != null;

      // delete: solo el super admin (botón "Eliminar" en la pestaña
      // Administración) — antes quedaba cubierto por el "write" de arriba,
      // lo que dejaba a cualquier sesión autenticada (incluido un socio que
      // adivinara el slug de otro) borrar el documento de monitoreo de
      // cualquier estacionamiento ajeno.
      allow delete: if esSuperAdmin();

      // list (consultar la colección completa, lo que hace
      // panel-operador/index.html) exige ser el super admin, o ser el
      // dueño Y que la consulta ya venga filtrada por su propio uid
      // (where('ownerUid','==', auth.uid)) — si el cliente no filtra,
      // Firestore rechaza la consulta completa. La auth anónima nunca
      // puede listar, así que no alcanza a enumerar estacionamientos
      // ajenos con solo la apiKey pública.
      allow list: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' && (
          esSuperAdmin() ||
          ('ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid)
        );

      // Boletos cerrados pendientes de facturar (facturacionSync.ts). Solo
      // el backend de facturación (Cloud Functions, vía Admin SDK) puede
      // tocarlos — el Admin SDK ignora estas reglas, así que "deny all"
      // aquí es exactamente lo que se busca: ningún cliente (panel-operador,
      // portal público, ni nadie con la API key) puede leer o alterar
      // montos/estado de facturación directamente.
      match /boletosFacturables/{codigoImpreso} {
        allow read, write: if false;
      }

      // Alertas de "boleto reciclado" (ver src/main/recobroSospechoso.ts) —
      // el escritorio (auth anónima) las crea/actualiza al detectarlas, y
      // el super admin o el dueño de este estacionamiento las puede leer
      // y marcar como revisadas desde panel-operador.
      match /alertasRecobro/{boletoId} {
        allow get, create, update: if request.auth != null;
        allow list: if request.auth != null &&
          request.auth.token.firebase.sign_in_provider != 'anonymous' && (
            esSuperAdmin() ||
            get(/databases/$(database)/documents/estacionamientos/$(slug)).data.ownerUid == request.auth.uid
          );
        allow delete: if esSuperAdmin();
      }
    }

    // Metadatos de socios (email/nombre) — los escribe solo la Cloud
    // Function crearSocio (Admin SDK); el super admin puede leerlos para
    // llenar la pestaña "Administración" del panel.
    match /socios/{uid} {
      allow read: if esSuperAdmin();
      allow write: if false;
    }

    // Secretos de facturación (organizationId + Secret Key de FacturAPI por
    // estacionamiento) — nunca deben ser legibles ni escribibles desde
    // ningún cliente, solo desde Cloud Functions con Admin SDK.
    match /facturacionSecretos/{slug} {
      allow read, write: if false;
    }

    // Cualquier otra ruta no contemplada arriba: denegada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
